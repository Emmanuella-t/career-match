# Career Match frontend environment example (no secrets).
# Copy to `.env.local` for local overrides. Values prefixed with
# NEXT_PUBLIC_ are inlined at build time for the browser bundle.

# Deployed FastAPI base URL (no trailing slash required).
# Local fallback in code is http://127.0.0.1:8000 when unset.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Clerk authentication (https://dashboard.clerk.com)
# Create an application, enable email/password, then paste keys here.
# Never commit real secrets — only placeholders belong in this file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Optional Clerk route hints (also set in ClerkProvider)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# Local dev: run `npm run dev` and open http://localhost:3001
# (binds to localhost, not 127.0.0.1, for Clerk development compatibility)
