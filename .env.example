# Career Match backend environment example (no secrets).
# Copy to `.env` locally if helpful; do not commit real credentials.
# The API loads this file automatically on startup — no --env-file flag needed.

# Comma-separated browser origins allowed by CORS.
# Local defaults apply when unset: localhost/127.0.0.1 on ports 3000 and 3001
# Production: set to your deployed frontend origin(s), e.g.
# CAREER_MATCH_CORS_ORIGINS=https://your-frontend.example.com
# CAREER_MATCH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Production listen settings (used by scripts/start_api_production.py / Procfile)
HOST=0.0.0.0
PORT=8000

# Optional: explicit Hugging Face / sentence-transformers cache directory
# CAREER_MATCH_MODEL_CACHE_DIR=/var/cache/career-match/models

# Frontend auth (Clerk) lives in frontend/.env.local — see frontend/.env.example.
# Public matching (POST /api/v1/match) stays open for guest use.
# Authenticated persistence endpoints require Clerk JWT verification below.

# Clerk issuer for backend JWT verification (canonical; no trailing slash).
# Legacy alias CLERK_ISSUER_URL is also accepted.
# Example: https://your-instance.clerk.accounts.dev
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional override; defaults to {CLERK_ISSUER}/.well-known/jwks.json
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Neon Postgres (backend-only — never expose DATABASE_URL to Next.js)
# Standard Neon postgresql:// URLs are normalized to psycopg 3 automatically.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Adzuna job search provider (backend-only — never expose to Next.js)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=us
